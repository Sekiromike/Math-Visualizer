# OpenAI API Key (leave as dummy if using Ollama)
OPENAI_API_KEY=dummy

# Base URL (default is Ollama on host)
# host.docker.internal works on Windows/Mac and on Linux (docker-compose maps it).
# On Linux, Ollama must listen on all interfaces: OLLAMA_HOST=0.0.0.0
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Model Name
# Ensure you have pulled this model: `ollama pull qwen2.5-coder`
OPENAI_MODEL_NAME=qwen2.5-coder

REDIS_URL=redis://redis:6379

# Optional
# LLM_TIMEOUT=300
# RENDER_TIMEOUT=600
# NEXT_PUBLIC_API_URL=http://localhost:8000
